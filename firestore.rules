rules_version = '2';

// Replace REPLACE_WITH_ADMIN_UID with the UID of the admin user you create in
// Firebase Console → Authentication → Users. (Add more UIDs to the list if needed.)
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }

    // Anyone can read products; only the admin can change them.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customers can place Cash-on-Delivery orders (create only); only the admin can read or manage them.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string
        && request.resource.data.total is number;
      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{id} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }
  }
}

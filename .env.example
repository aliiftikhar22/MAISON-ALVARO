# Copy to .env.local and fill in. Leave Firebase blank to run in DEMO MODE
# (products/orders are stored only in the visitor's own browser).

# Public site URL (used for SEO metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Firebase (Firestore + Authentication) — enables real orders and admin login
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (admin product image uploads) — create an UNSIGNED upload preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
